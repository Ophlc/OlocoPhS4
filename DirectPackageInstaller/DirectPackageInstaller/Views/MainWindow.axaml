<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DirectPackageInstaller.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DirectPackageInstaller.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        Width="1280"
        Height="800"
        MinWidth="1080"
        MinHeight="700"
        x:Class="DirectPackageInstaller.Views.MainWindow"
        Icon="/Assets/olocophs4-installer.png"
        Background="#07060A"
        Title="OlocoPhS4 Installer">
        <views:MainView Name="View"/>
</Window>
